{
  "name": "nltag-website",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hostinger": "node scripts/hostinger-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:tokens": "node scripts/token-audit.mjs",
    "review:tamil": "node scripts/tamil-review.ts",
    "review:tamil:check": "node scripts/tamil-review.ts --check",
    "verify": "npm run audit:tokens && npm run review:tamil:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:seed:content": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/seed-content.ts",
    "db:seed:public": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/seed-public-fixtures.ts",
    "admin:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/create-first-admin.ts",
    "admin:bootstrap:env": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/bootstrap-admin-from-env.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.integration.production.config.ts",
    "staging:verify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/staging/staging.ts verify",
    "staging:init": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/staging/staging.ts init && tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/migrate.ts --staging",
    "staging:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db/migrate.ts --staging",
    "staging:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/staging/staging.ts seed",
    "staging:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/staging/staging.ts bootstrap"
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}

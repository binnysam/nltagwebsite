# Variable names only. Never commit real values.
# Shows the private design-system gallery at /[locale]/design-system when set to 1 (never in production).
NLTAG_DESIGN_SYSTEM_GALLERY=0

# ── Phase 4b: database and accounts (server only; never commit real values) ──
# Local MariaDB 11.8. On Hostinger use 127.0.0.1, never localhost.
DATABASE_URL=mysql://nltag:change-me@127.0.0.1:3306/nltag_dev
# 32+ random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Public origin of the site (https in production).
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in (church-owned Google Cloud client, D3). Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP with an App Password (Phase 4a). Leave empty until the owner approves the email test;
# without it, development writes emails to .data/mail/ and production refuses to send.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Account pages and /api/auth return 404 unless this is 1. In production SMTP_* must also be set
# and AUTH_RATE_LIMIT must be explicitly "on" (docs/operations/admin-activation.md).
NLTAG_ACCOUNTS_ENABLED=0
# Auth rate limiting. Defaults to on; production cannot switch it off, and the accounts gate
# requires it to be set explicitly to "on".
AUTH_RATE_LIMIT=on
# Staff-only sign-up (Phase 6a): comma-separated addresses that may create an account. Everyone
# else gets the same "check your email" reply and nothing happens. In production, unset or
# invalid = nobody can sign up. Leave empty locally for open sign-up.
NLTAG_SIGNUP_ALLOWLIST=
# One-time first Church Admin grant during the Hostinger build. Set for ONE build, then remove.
# Never set locally; use `npm run admin:bootstrap -- <email>` instead.
NLTAG_BOOTSTRAP_ADMIN_EMAIL=
# Rolling 24-hour cap on outgoing mail (Gmail allows 500).
EMAIL_DAILY_CAP=300
# Client IP behind Hostinger's CDN (docs/backend/client-ip.md). Unset = every visitor shares one
# rate-limit bucket per path (fail closed). Set CLIENT_IP_SOURCE=forwarded-chain only after the
# header-shape capture (client_ip.shape log lines) has confirmed CLIENT_IP_PROXY_HOPS.
# Locally, leave unset (dev falls back to 127.0.0.1). TRUSTED_PROXIES is no longer used.
CLIENT_IP_SOURCE=
CLIENT_IP_PROXY_HOPS=0
CLIENT_IP_CROSSCHECK=x-real-ip
# Header-shape capture: logs each distinct forwarding-header layout once (no addresses). on|off
CLIENT_IP_SHAPE_LOG=on
